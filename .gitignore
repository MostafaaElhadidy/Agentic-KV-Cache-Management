# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Virtual envs (the vLLM env lives outside this repo)
.venv/
venv/
env/

# Logs (raw run logs, memory monitors)
*.log
logs/

# Results: small JSON/MD/PNG results are tracked; bulky or regenerable ones are not
results/traces/*.json
!results/traces/stats.json
results/traces_cloud/
results/smoke/
results/tiny/
results/**/*.tmp

# Models, weights, caches
*.safetensors
*.bin
*.pt
*.pth
*.gguf
models/
!configs/models/
hf_cache/
.cache/
.huggingface/

# Windows / editor junk
*:Zone.Identifier
*.Zone.Identifier
.DS_Store
.vscode/
.idea/

# Claude Code local-only settings
.claude/settings.local.json

# Datasets (downloaded by scripts/fetch_gsm8k.sh); only checksums are tracked
data/*
!data/gsm8k/
data/gsm8k/*
!data/gsm8k/SHA256SUMS
# bulky per-call prompt dumps of real-agent runs
results/**/prompts.jsonl.gz

# Demo runs (scripts/demo.py) are local; only the example cited in the README is tracked
results/demo/*
!results/demo/demo_20261007-064340/
!results/demo/replay_demo_20261007-064340/

# Beginner guide: kept local, not published (user decision 2026-10-08)
docs/GUIDE.md
docs/GUIDE.pdf
docs/guide_img/
